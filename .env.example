# Banco Postgres. Em produção: a URL do Supabase (DATABASE_URL).
# Em desenvolvimento local dá para usar as variáveis padrão do Postgres:
# PGHOST=/caminho/do/socket  PGPORT=5432  PGUSER=postgres  PGDATABASE=posto
DATABASE_URL=

# Segredo para assinar o cookie de sessão (32+ caracteres aleatórios).
SESSION_SECRET=

# Diferença de caixa (em centavos) a partir da qual o fechamento exige justificativa.
LIMITE_DIFERENCA_CENTAVOS=500
